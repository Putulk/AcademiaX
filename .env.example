# Copy this file to .env before running `docker compose up` if you want to
# override the defaults. Every value here already has a working fallback
# baked into docker-compose.yml / each service's application.yml, so this
# is optional for local use — set real values for anything beyond a single
# developer's machine.

# Shared HMAC signing secret for every service's JWT validation. All
# services must use the SAME secret. The default below matches what's
# already checked into every application.yml for local dev; generate a
# fresh one (e.g. `openssl rand -hex 32`) for anything beyond your own machine.
JWT_SECRET=4eab74d923edcecae9839fb51a6b4b2d0b5d748b73d9421af74d6f7a8d7c3e9f

# MySQL credentials — shared by the mysql container (MYSQL_ROOT_PASSWORD)
# and every service's datasource config.
DB_USERNAME=root
DB_PASSWORD=changeme
